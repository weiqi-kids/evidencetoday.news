---
interface Props {
  publishDate: Date;
  updatedDate?: Date;
  readingTime?: number;
}

const { publishDate, updatedDate, readingTime } = Astro.props;

const formatDate = (d: Date) => d.toISOString().slice(0, 10);
const pubStr = formatDate(publishDate);
const updStr = updatedDate ? formatDate(updatedDate) : null;
const showUpdated = updStr && updStr !== pubStr;
---

{/* 2026-11-28：拿掉每項前的小圖示、「最後更新」縮成「更新」，三項用間隔點串成一行，手機上不再拆成兩行 */}
<p class="author-meta">
  <span class="author-meta__item">發佈 {pubStr}</span>
  {showUpdated && <span class="author-meta__item">更新 {updStr}</span>}
  {readingTime && <span class="author-meta__item">閱讀 {readingTime} 分鐘</span>}
</p>

<style>
  .author-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    margin: 0;
    font-size: var(--text-meta);
    font-family: var(--font-ui);
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-muted);
  }

  .author-meta__item + .author-meta__item::before {
    content: '·';
    margin-inline-end: 0.5rem;
    color: var(--color-ink-subtle);
  }
</style>
