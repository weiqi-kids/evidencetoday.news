---
/**
 * 首頁「本日有據至今」數字條：已公開篇數與可點來源數，進入畫面時數字像里程表一樣滾到定位。
 *
 * - 數字在 build 時由呼叫端（index.astro）從 collection 算好傳入，不寫死、不手改
 * - SSR 輸出的是真正的數字文字（搜尋引擎、AI 摘要、無 JS 讀者都讀得到）；滾動用的數字條由
 *   client script 動態產生並標 aria-hidden，真正的數字保留在 .sr-only 給螢幕閱讀器
 * - 系統設定「減少動態效果」或瀏覽器不支援 IntersectionObserver 時，不做任何替換，直接顯示數字
 * - 版面規則見 docs/playbooks/home-hero.md「本日有據至今 數字條」
 */
interface Stat {
  value: number;
  label: string;
  note: string;
  href?: string;
  tone: 'article' | 'myth' | 'ingredient' | 'source';
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
const fmt = (n: number) => n.toLocaleString('en-US');
---

<section id="site-stats" class="site-stats" aria-labelledby="site-stats-title">
  <div class="container">
    <h2 id="site-stats-title" class="site-stats__title">本日有據至今</h2>
    <ul class="site-stats__grid" role="list">
      {stats.map((s) => {
        const Tag = s.href ? 'a' : 'div';
        return (
          <li class="site-stats__item">
            <Tag class={`site-stats__card site-stats__card--${s.tone}`} href={s.href}>
              <span class="site-stats__num" data-roll={s.value}>{fmt(s.value)}</span>
              <span class="site-stats__label">{s.label}</span>
              <span class="site-stats__note">{s.note}</span>
            </Tag>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nums = Array.from(document.querySelectorAll<HTMLElement>('.site-stats__num[data-roll]'));

  if (!reduce && 'IntersectionObserver' in window && nums.length > 0) {
    nums.forEach((el, statIndex) => {
      const text = el.textContent ?? '';
      const label = document.createElement('span');
      label.className = 'sr-only';
      label.textContent = text;

      const roll = document.createElement('span');
      roll.className = 'roll';
      roll.setAttribute('aria-hidden', 'true');
      let digitIndex = 0;
      for (const ch of text) {
        if (/[0-9]/.test(ch)) {
          const win = document.createElement('span');
          win.className = 'roll__window';
          const strip = document.createElement('span');
          strip.className = 'roll__strip';
          strip.style.setProperty('--d', ch);
          strip.style.setProperty('--delay', `${statIndex * 120 + digitIndex * 90}ms`);
          for (let n = 0; n <= 9; n += 1) {
            const cell = document.createElement('span');
            cell.className = 'roll__cell';
            cell.textContent = String(n);
            strip.appendChild(cell);
          }
          win.appendChild(strip);
          roll.appendChild(win);
          digitIndex += 1;
        } else {
          const sep = document.createElement('span');
          sep.className = 'roll__sep';
          sep.textContent = ch;
          roll.appendChild(sep);
        }
      }
      el.replaceChildren(label, roll);
    });

    const grid = document.querySelector('.site-stats__grid');
    if (grid) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            grid.classList.add('is-rolled');
            io.disconnect();
          }
        },
        { threshold: 0.4 },
      );
      io.observe(grid);
    }
  }
</script>

<style>
  .site-stats {
    padding: var(--space-section-gap) 0 0;
  }

  .site-stats__title {
    font-family: var(--font-ui);
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 1rem;
  }

  /* mobile-first：手機 2 欄、≥1024 4 欄 */
  .site-stats__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-card-gap);
  }

  @media (min-width: 1024px) {
    .site-stats__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .site-stats__item {
    min-width: 0;
  }

  .site-stats__card {
    height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.25rem 1.25rem 1.35rem;
    border-radius: var(--radius-card);
    background-color: var(--color-white);
    box-shadow: var(--shadow-card);
    color: var(--color-ink);
    text-decoration: none;
    transition: box-shadow 0.2s ease;
  }

  a.site-stats__card:hover {
    box-shadow: var(--shadow-card-hover);
  }

  a.site-stats__card:focus-visible {
    outline: 3px solid var(--color-coral);
    outline-offset: 3px;
  }

  .site-stats__card--article .site-stats__num { color: var(--color-cat-article); }
  .site-stats__card--myth .site-stats__num { color: var(--color-cat-myth); }
  .site-stats__card--ingredient .site-stats__num { color: var(--color-cat-ingredient); }
  .site-stats__card--source .site-stats__num { color: var(--color-navy); }

  .site-stats__num {
    display: flex;
    align-items: flex-start;
    font-family: var(--font-ui);
    font-size: var(--text-h1);
    font-weight: 700;
    line-height: 1.15;
    height: 1.15em;
    font-variant-numeric: tabular-nums;
  }

  .site-stats__label {
    font-family: var(--font-ui);
    font-size: var(--text-body);
    font-weight: 700;
    color: var(--color-navy);
  }

  .site-stats__note {
    font-family: var(--font-ui);
    font-size: var(--text-meta);
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  /* 滾動數字條：元素由 client script 產生，沒有 Astro scope 屬性，所以用 :global() */
  .site-stats :global(.roll) {
    display: inline-flex;
    align-items: flex-start;
  }

  .site-stats :global(.roll__window) {
    display: inline-block;
    height: 1.15em;
    overflow: hidden;
  }

  .site-stats :global(.roll__strip) {
    display: flex;
    flex-direction: column;
    transform: translateY(0);
  }

  .site-stats :global(.is-rolled .roll__strip) {
    transform: translateY(calc(var(--d) * -1.15em));
    transition: transform 1.4s cubic-bezier(0.2, 0.8, 0.2, 1) var(--delay);
  }

  .site-stats :global(.roll__cell),
  .site-stats :global(.roll__sep) {
    display: block;
    height: 1.15em;
    line-height: 1.15em;
  }
</style>
