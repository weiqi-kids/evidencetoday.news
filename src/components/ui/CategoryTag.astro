---
interface Props {
  category: 'article' | 'myth' | 'ingredient' | 'podcast' | 'video' | 'news';
  class?: string;
}

const { category, class: className } = Astro.props;

const labelMap: Record<string, string> = {
  article: '文章',
  myth: '闢謠',
  ingredient: '成分解析',
  podcast: 'Podcast',
  video: '短影音',
  news: '趨勢',
};

const label = labelMap[category];
const classes = `cat-tag cat-tag--${category}${className ? ` ${className}` : ''}`;
---

<span class={classes}>{label}</span>

<style>
  /* 2026-11-28：從底色膠囊改成分類色純文字。卡片與文章頁頂的類別只是識別，不是可點的控制項，
     做成膠囊會和真正的按鈕、判定標章搶視覺；全站卡片統一用這一種寫法（見 docs/brand-guidelines.md）。 */
  .cat-tag {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-ui);
    font-size: var(--text-meta);
    font-weight: 700;
    line-height: 1.4;
    white-space: nowrap;
  }

  .cat-tag--article { color: var(--color-cat-article); }
  .cat-tag--myth { color: var(--color-cat-myth); }
  .cat-tag--ingredient { color: var(--color-cat-ingredient); }
  .cat-tag--podcast { color: var(--color-cat-podcast); }
  .cat-tag--video { color: var(--color-cat-video); }
  .cat-tag--news { color: var(--color-cat-news); }
</style>
