---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="breadcrumb">
  <ol>
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li>
          {index > 0 && <span class="breadcrumb__sep" aria-hidden="true">/</span>}
          {isLast ? (
            <span aria-current="page">{item.label}</span>
          ) : (
            <a href={item.href}>{item.label}</a>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .breadcrumb {
    font-family: var(--font-ui);
    font-size: var(--text-meta);
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 0.25rem;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  /* 2026-11-28：手機只顯示到上一層（目前頁的標題就是下方的 h1，重複顯示會讓麵包屑折成兩行、把標題往下推）。
     結構化資料的麵包屑另外輸出，不受影響。 */
  li:last-child:not(:first-child) {
    display: none;
  }

  @media (min-width: 640px) {
    li:last-child:not(:first-child) {
      display: inline-flex;
    }
  }

  .breadcrumb__sep {
    color: var(--color-fog);
    user-select: none;
  }

  a {
    color: var(--color-teal);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  [aria-current='page'] {
    color: var(--color-ink);
    font-weight: 500;
  }
</style>
