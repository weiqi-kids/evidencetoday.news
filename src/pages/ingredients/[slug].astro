---
import { getCollection, getEntry } from 'astro:content';
import Article from '@/layouts/Article.astro';
import EditButton from '@/components/editor/EditButton.svelte';
import JsonLd from '@/components/seo/JsonLd.astro';
import TableOfContents from '@/components/blocks/TableOfContents.svelte';
import ArticleCard from '@/components/blocks/ArticleCard.astro';
import MythCard from '@/components/blocks/MythCard.astro';
import VideoCard from '@/components/blocks/VideoCard.astro';
import PodcastCard from '@/components/blocks/PodcastCard.astro';
import { fmtDate } from '@/utils/date';
import { stripPodcastSlug } from '@/utils/podcasts';
import { contentSocial } from '@/utils/social-meta.mjs';
import ReadingEngagement from '@/components/blocks/ReadingEngagement.svelte';
import { buildCitations, buildPerson, PUBLISHER_REF, WEBSITE_REF } from '@/utils/schema-org';
import { isPublicEntry } from '@/utils/visibility';
import IngredientCard from '@/components/blocks/IngredientCard.astro';
import { getAutoRelated } from '@/utils/related';
import { filterBoilerplateItems, dropIfInBody } from '@/utils/boilerplate';
import { TOPICS, matchesTopic } from '@/data/topics';

function stripExt(id: string): string {
  return id.replace(/\.[^.]+$/, '');
}

export async function getStaticPaths() {
  const entries = await getCollection('ingredients', ({ data }) => isPublicEntry(data));
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.[^.]+$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

const data = entry.data;

/* 「研究中討論的用途」（2026-08-07 上架）。
   ingredientsSchema.uses 從建站起就有資料，51/64 篇寫的是真的臨床試驗摘要
   （樣本數、劑量、試驗長度、結論限制），但沒有任何模板讀它——那正是 AI 答案引擎
   最需要、也最難從別處抄到的內容。

   兩層過濾，都是量出來的不是猜的：
   ① filterBoilerplateItems：14 篇填的是「核心知識與來源辨識／整理定義、來源與常見型態」
      這種對任何成分都成立的句子，跨篇比對後整批濾掉。
   ② dropIfInBody：這一項內文散文已經講過就不重印。這正是本檔原本「刻意不接 uses」
      的理由，但實測重疊率中位數只有 16.2%、只有 13 篇超過 30%，整個欄位都不接
      對其餘 38 篇是過度反應。改成逐項判斷。 */
const usesAll = await filterBoilerplateItems('ingredients', 'uses', data.uses);
const visibleUses = dropIfInBody(usesAll, entry.body ?? '', (u) => u.summary ?? '');

/* 證據等級中文化：前台不出現 rct / meta-analysis 這類原始 enum 值。
   與 src/utils/evidence-labels.ts 同一套說法，避免同一個概念站上有兩種講法。 */
const USE_EVIDENCE_LABEL: Record<string, string> = {
  'meta-analysis': '系統性回顧／統合分析',
  rct: '隨機對照試驗',
  observational: '觀察性研究',
  animal: '動物實驗',
  'in-vitro': '體外實驗',
};

const social = contentSocial('ingredients', data, entry.id.replace(/\.[^.]+$/, ''));

/* Resolve related content
   手動 relatedX 只解析**已公開**的項目。`filter(Boolean)` 只擋掉「不存在」，擋不掉
   「還沒到 publishDate」——那種稿在 dist 裡不存在，渲染出來就是死連結，`check:site`
   會讓 build 紅、擋掉全站部署（硬規則 12、docs/pitfalls.md）。
   2026-09-02 實際炸過：cron 自動發布的 dong-quai 在 relatedArticles 填了四篇
   10 月底才上線的節氣文。 */
const resolveManual = async (collection, ids) =>
  ids
    ? (await Promise.all(ids.map((id) => getEntry(collection, id)))).filter((e) => e && isPublicEntry(e.data))
    : [];

const manualArticles = await resolveManual('articles', data.relatedArticles);
const manualMyths = await resolveManual('myths', data.relatedMyths);
const manualVideos = await resolveManual('videos', data.relatedVideos);
const manualPodcasts = await resolveManual('podcasts', data.relatedPodcasts);
const manualIngredients = await resolveManual('ingredients', data.relatedIngredients);
const hasManual = manualArticles.length > 0 || manualMyths.length > 0 || manualVideos.length > 0 || manualPodcasts.length > 0 || manualIngredients.length > 0;

/* 手動全空 → 用 tag 重疊自動補相關內容（同 articles/[slug].astro 的作法）。
   成分頁 63 篇中只有 5 篇填了 relatedX，其餘過去都渲染出空的相關區、
   對外零出鏈，是全站最孤立的一群頁面。 */
const auto = hasManual
  ? { articles: [], myths: [], ingredients: [], videos: [], podcasts: [] }
  : await getAutoRelated({ tags: data.tags ?? [], title: data.title, exclude: { collection: 'ingredients', id: entry.id }, perBucket: 3 });

const relatedArticles = hasManual ? manualArticles : auto.articles;
const relatedMyths = hasManual ? manualMyths : auto.myths;
const relatedVideos = hasManual ? manualVideos : auto.videos;
const relatedPodcasts = hasManual ? manualPodcasts : auto.podcasts;
/* 同類成分也是出口。成分頁的讀者多半在「比較該吃哪一個」，推薦另一個成分比推薦一篇
   泛用文章更貼近意圖；而且成分之間的標籤共用度遠高於跨 collection——2026-08-07 實測，
   folate／lions-mane／resveratrol／spermidine／taurine／vitamin-b-complex 這 6 篇
   在文章與闢謠裡找不到任何相關內容（成分的標籤詞彙自成一套，articles 從沒用過
   「礦物質」「維生素」「脂溶性營養素」這些字），但彼此之間找得到。 */
const relatedIngredients = hasManual ? manualIngredients : auto.ingredients;

const hasRelated = relatedArticles.length > 0 || relatedMyths.length > 0 || relatedVideos.length > 0 || relatedPodcasts.length > 0 || relatedIngredients.length > 0;

/* spoke→hub 回鏈：本成分所屬的健康專題（關鍵字比對 title+tags 自動判斷） */
const belongingTopics = TOPICS.filter((t) => matchesTopic(t, { title: data.title, tags: data.tags }));

/* JSON-LD structured data */
const slug = entry.id.replace(/\.[^.]+$/, '');
/* frontmatter 的 references 同樣過樣板濾網（2026-08-07）。
   13 篇成分頁的 references 一字不差，內容是 NIH ODS / EFSA / Merck Manual / Cochrane /
   PubMed 的**首頁**連結——那不是引用，是「我們查過這些資料庫」。而且它渲染兩次：
   一次是可見的參考資料區塊，一次是 JSON-LD 的 citation，等於對 Google 宣告 13 頁引用
   同一組來源。真正逐篇寫的具體引用（含 DOI 與期刊卷期）在 MDX body 裡，本來就會顯示，
   濾掉泛用清單之後那份才是這一頁唯一的參考資料。 */
const ingredientReferences = await filterBoilerplateItems('ingredients', 'references', data.references);
const ingredientCitations = buildCitations(ingredientReferences);
const ingredientArticleSchema = {
  '@context': 'https://schema.org',
  '@type': ['Article', 'MedicalWebPage'],
  '@id': `https://evidencetoday.news/ingredients/${slug}/#article`,
  headline: data.title,
  description: data.description,
  inLanguage: 'zh-Hant-TW',
  ...(data.coverImage ? { image: new URL(data.coverImage, 'https://evidencetoday.news').href } : {}),
  datePublished: data.publishDate.toISOString(),
  dateModified: data.updatedDate.toISOString(),
  lastReviewed: data.updatedDate.toISOString(),
  medicalAudience: { '@type': 'MedicalAudience', audienceType: 'Patient' },
  // 成分解析由編輯部彙整，作者維持機構級；但掛了獨立醫療審閱者時，reviewedBy 升級為
  // Person（含 hasCredential），這才是 E-E-A-T 有分量的部分。沒掛才退回機構級。
  author: PUBLISHER_REF,
  reviewedBy: data.reviewer ? buildPerson(data.reviewer) : PUBLISHER_REF,
  ...(data.reviewer ? { lastReviewed: data.updatedDate.toISOString() } : {}),
  publisher: PUBLISHER_REF,
  isPartOf: WEBSITE_REF,
  about: {
    '@type': 'Thing',
    name: data.title,
  },
  ...(ingredientCitations ? { citation: ingredientCitations } : {}),
  articleSection: '成分解析',
  mainEntityOfPage: `https://evidencetoday.news/ingredients/${slug}/`,
};

const ingredientBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://evidencetoday.news/' },
    { '@type': 'ListItem', position: 2, name: '成分解析', item: 'https://evidencetoday.news/ingredients/' },
    { '@type': 'ListItem', position: 3, name: data.title, item: `https://evidencetoday.news/ingredients/${slug}/` },
  ],
};
---

<Article
  title={data.title}
  description={social.description}
  seoTitle={data.seoTitle ?? social.title}
  socialTitle={social.title}
  socialDescription={social.description}
  ogImage={social.image}
  coverImage={data.coverImage}
  coverAlt={data.coverAlt}
  coverImageCredit={data.coverImageCredit}
  category="ingredient"
  publishDate={data.publishDate}
  updatedDate={data.updatedDate}
  reviewer={data.reviewer}
  disclosure={data.disclosure}
  tags={data.tags}
  breadcrumbItems={[
    { label: '首頁', href: '/' },
    { label: '成分解析', href: '/ingredients/' },
    { label: data.title },
  ]}
  references={ingredientReferences}
  citationAnswer={data.introduction}
>
  <Fragment slot="head">
    <JsonLd data={ingredientArticleSchema} />
    <JsonLd data={ingredientBreadcrumbSchema} />
  </Fragment>

  <Content />

  {/*
    安全性與交互作用（2026-08-06 接線）。
    `ingredientsSchema.safety` 從建站起就有資料——20 篇成分頁寫了一般安全性、
    交互作用與族群注意——但沒有任何模板讀它，讀者一個字都看不到。
    `docs/page-rules/ingredients.md` 早就規定「content 有 safety 欄位時，模板需
    固定輸出『安全性與交互作用』區塊」，屬於規格寫了、實作沒做。勿再移除。

    刻意只接 safety，不接 uses：寫得好的成分頁（如 taurine、urolithin-a）body
    已用散文講過用途與證據，把 uses 也渲染出來會在同一頁產生兩份近似內容。
    safety 是條列式的交互作用與族群注意，body 通常不會逐條重複，重疊風險低。
  */}
  {visibleUses.length > 0 && (
    <section class="ingredient-uses" aria-labelledby="ingredient-uses-title">
      <h2 id="ingredient-uses-title">研究中討論的用途</h2>
      <p class="ingredient-uses__note">以下是研究文獻中討論過的用途與證據強度，不是療效宣稱，也不代表適合每個人。</p>
      <ul class="ingredient-uses__list">
        {visibleUses.map((u) => (
          <li class="ingredient-uses__item">
            <div class="ingredient-uses__head">
              <h3>{u.purpose}</h3>
              <span class="ingredient-uses__level">{USE_EVIDENCE_LABEL[u.evidenceLevel] ?? u.evidenceLevel}</span>
            </div>
            <p>{u.summary}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  {data.safety && (
    <section class="ingredient-safety" aria-labelledby="ingredient-safety-title">
      <h2 id="ingredient-safety-title">安全性與交互作用</h2>
      <p>{data.safety.general}</p>

      {data.safety.interactions && data.safety.interactions.length > 0 && (
        <>
          <h3>可能的交互作用</h3>
          <dl>
            {data.safety.interactions.map((item) => (
              <>
                <dt>{item.substance}</dt>
                <dd>{item.description}</dd>
              </>
            ))}
          </dl>
        </>
      )}

      {data.safety.populations && data.safety.populations.length > 0 && (
        <>
          <h3>特定族群注意事項</h3>
          <dl>
            {data.safety.populations.map((item) => (
              <>
                <dt>{item.group}</dt>
                <dd>{item.note}</dd>
              </>
            ))}
          </dl>
        </>
      )}
    </section>
  )}

  <Fragment slot="sidebar">
    {headings.length > 0 && (
      <TableOfContents headings={headings} client:idle />
    )}
  </Fragment>

  {(hasRelated || belongingTopics.length > 0) && (
    <Fragment slot="after-content">
      {belongingTopics.length > 0 && (
        <nav class="topic-hubs" aria-label="所屬健康專題">
          <h2 class="topic-hubs__title">所屬健康專題</h2>
          <div class="topic-hubs__links">
            {belongingTopics.map((t) => (
              <a class="topic-hubs__link" href={`/topics/${t.slug}/`}>{t.name}</a>
            ))}
          </div>
        </nav>
      )}
      {hasRelated && (
      <section class="related-content">
        <h2 class="related-content__title">相關內容</h2>
        <div class="related-content__grid">
          {relatedArticles.map((a) => (
            <ArticleCard
              title={a.data.title}
              description={a.data.description}
              href={`/articles/${stripExt(a.id)}/`}
              category="article"
              coverImage={a.data.coverImage}
              coverAlt={a.data.coverAlt}
              author={a.data.author}
              date={fmtDate(a.data.publishDate)}
              editorReviewed={a.data.editorReviewed}
            />
          ))}
          {relatedMyths.map((m) => (
            <MythCard
              title={m.data.title}
              verdictSummary={m.data.verdictSummary}
              href={`/myths/${stripExt(m.id)}/`}
              verdict={m.data.verdict}
              date={fmtDate(m.data.publishDate)}
            />
          ))}
          {relatedIngredients.map((i) => (
            <IngredientCard
              title={i.data.title}
              titleEn={i.data.titleEn}
              description={i.data.description}
              href={`/ingredients/${stripExt(i.id)}/`}
              uses={i.data.uses}
              coverImage={i.data.coverImage}
              coverAlt={i.data.coverAlt}
              tags={i.data.tags}
            />
          ))}
          {relatedVideos.map((v) => (
            <VideoCard
              title={v.data.title}
              tldr={v.data.tldr}
              href={`/videos/${stripExt(v.id)}/`}
              youtubeId={v.data.youtubeId}
            />
          ))}
          {relatedPodcasts.map((p) => (
            <PodcastCard
              title={p.data.title}
              description={p.data.description}
              href={`/podcasts/${stripPodcastSlug(p.id)}/`}
              episodeNumber={p.data.episodeNumber}
              duration={p.data.duration}
              publishDate={p.data.publishDate}
            />
          ))}
        </div>
      </section>
      )}
    </Fragment>
  )}
</Article>
<EditButton client:idle repoPath={`src/content/ingredients/${entry.id}`} collection="ingredients" slug={slug} />
<ReadingEngagement client:idle contentType="ingredient" slug={slug} tags={data.tags} hasRelated={hasRelated} />

<style>
  /* 安全性與交互作用：接在內文之後的固定區塊。
     用 dl 而非 ul，因為每一條都是「對象 → 說明」的配對，語意上是定義列表；
     螢幕閱讀器可據此把物質名與說明關聯起來。字級全部走 --text-* 階梯。 */
  /* 「研究中討論的用途」：與 .ingredient-safety 同一套視覺語彙（分隔線起始、同字級階梯），
     兩區塊相鄰時看起來是同一層級的內容，而不是後補上去的東西。 */
  .ingredient-uses {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-fog);
  }

  .ingredient-uses h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 0.5rem;
  }

  /* 這句是體例聲明不是內容，降彩度、不縮字（硬規則 10：低干擾靠位置與彩度，不靠縮字）。 */
  .ingredient-uses__note {
    font-size: var(--text-meta);
    color: var(--color-ink-muted);
    margin: 0 0 1.25rem;
  }

  .ingredient-uses__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .ingredient-uses__item {
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-fog);
    border-radius: var(--radius-sm);
    background: var(--color-teal-subtle);
  }

  .ingredient-uses__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    margin-bottom: 0.5rem;
  }

  .ingredient-uses__head h3 {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
  }

  .ingredient-uses__level {
    font-size: var(--text-meta);
    font-weight: 600;
    color: var(--color-teal);
    white-space: nowrap;
  }

  .ingredient-uses__item p {
    font-size: var(--text-body);
    line-height: 1.8;
    color: var(--color-ink);
    margin: 0;
    max-width: 40em;
  }

  .ingredient-safety {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-fog);
  }

  .ingredient-safety h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 1rem;
  }

  .ingredient-safety h3 {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-ink);
    margin: 1.5rem 0 0.75rem;
  }

  .ingredient-safety p {
    font-size: var(--text-body);
    line-height: 1.8;
    color: var(--color-ink);
    margin: 0;
  }

  .ingredient-safety dl {
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }

  .ingredient-safety dt {
    font-size: var(--text-body);
    font-weight: 700;
    color: var(--color-ink);
  }

  .ingredient-safety dd {
    margin: 0.25rem 0 0;
    font-size: var(--text-body);
    line-height: 1.75;
    color: var(--color-ink);
  }

  /* spoke→hub 專題膠囊，與 articles/[slug].astro 同一套視覺 */
  .topic-hubs {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .topic-hubs__title {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-ink);
  }

  .topic-hubs__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .topic-hubs__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-ui);
    font-size: var(--text-meta);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-teal);
    background: var(--color-teal-subtle);
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
  }

  .topic-hubs__link::before {
    content: '專題';
    font-size: var(--text-meta);
    font-weight: 700;
    opacity: 0.7;
  }

  .related-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .related-content__title {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-ink);
  }

  .related-content__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-card-gap);
  }

  @media (min-width: 640px) {
    .related-content__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

</style>
