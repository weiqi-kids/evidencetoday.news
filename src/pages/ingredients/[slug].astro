---
import { getCollection, getEntry } from 'astro:content';
import Article from '@/layouts/Article.astro';
import EditButton from '@/components/editor/EditButton.svelte';
import JsonLd from '@/components/seo/JsonLd.astro';
import TableOfContents from '@/components/blocks/TableOfContents.svelte';
import ArticleCard from '@/components/blocks/ArticleCard.astro';
import MythCard from '@/components/blocks/MythCard.astro';
import VideoCard from '@/components/blocks/VideoCard.astro';
import PodcastCard from '@/components/blocks/PodcastCard.astro';
import { fmtDate } from '@/utils/date';
import { stripPodcastSlug } from '@/utils/podcasts';
import { contentSocial } from '@/utils/social-meta.mjs';
import ReadingEngagement from '@/components/blocks/ReadingEngagement.svelte';
import { buildCitations, buildPerson, PUBLISHER_REF, WEBSITE_REF } from '@/utils/schema-org';
import { isPublicEntry } from '@/utils/visibility';
import { getAutoRelated } from '@/utils/related';
import { TOPICS, matchesTopic } from '@/data/topics';

function stripExt(id: string): string {
  return id.replace(/\.[^.]+$/, '');
}

export async function getStaticPaths() {
  const entries = await getCollection('ingredients', ({ data }) => isPublicEntry(data));
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.[^.]+$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const data = entry.data;
const social = contentSocial('ingredients', data, entry.id.replace(/\.[^.]+$/, ''));

/* Resolve related content */
const manualArticles = data.relatedArticles
  ? (await Promise.all(data.relatedArticles.map((id) => getEntry('articles', id)))).filter(Boolean)
  : [];
const manualMyths = data.relatedMyths
  ? (await Promise.all(data.relatedMyths.map((id) => getEntry('myths', id)))).filter(Boolean)
  : [];
const manualVideos = data.relatedVideos
  ? (await Promise.all(data.relatedVideos.map((id) => getEntry('videos', id)))).filter(Boolean)
  : [];
const manualPodcasts = data.relatedPodcasts
  ? (await Promise.all(data.relatedPodcasts.map((id) => getEntry('podcasts', id)))).filter(Boolean)
  : [];
const hasManual = manualArticles.length > 0 || manualMyths.length > 0 || manualVideos.length > 0 || manualPodcasts.length > 0;

/* 手動全空 → 用 tag 重疊自動補相關內容（同 articles/[slug].astro 的作法）。
   成分頁 63 篇中只有 5 篇填了 relatedX，其餘過去都渲染出空的相關區、
   對外零出鏈，是全站最孤立的一群頁面。 */
const auto = hasManual
  ? { articles: [], myths: [], ingredients: [], videos: [], podcasts: [] }
  : await getAutoRelated({ tags: data.tags ?? [], exclude: { collection: 'ingredients', id: entry.id }, perBucket: 3 });

const relatedArticles = hasManual ? manualArticles : auto.articles;
const relatedMyths = hasManual ? manualMyths : auto.myths;
const relatedVideos = hasManual ? manualVideos : auto.videos;
const relatedPodcasts = hasManual ? manualPodcasts : auto.podcasts;

const hasRelated = relatedArticles.length > 0 || relatedMyths.length > 0 || relatedVideos.length > 0 || relatedPodcasts.length > 0;

/* spoke→hub 回鏈：本成分所屬的健康專題（關鍵字比對 title+tags 自動判斷） */
const belongingTopics = TOPICS.filter((t) => matchesTopic(t, { title: data.title, tags: data.tags }));

/* JSON-LD structured data */
const slug = entry.id.replace(/\.[^.]+$/, '');
const ingredientCitations = buildCitations(data.references);
const ingredientArticleSchema = {
  '@context': 'https://schema.org',
  '@type': ['Article', 'MedicalWebPage'],
  '@id': `https://evidencetoday.news/ingredients/${slug}/#article`,
  headline: data.title,
  description: data.description,
  inLanguage: 'zh-Hant-TW',
  ...(data.coverImage ? { image: new URL(data.coverImage, 'https://evidencetoday.news').href } : {}),
  datePublished: data.publishDate.toISOString(),
  dateModified: data.updatedDate.toISOString(),
  lastReviewed: data.updatedDate.toISOString(),
  medicalAudience: { '@type': 'MedicalAudience', audienceType: 'Patient' },
  // 成分解析由編輯部彙整，作者維持機構級；但掛了獨立醫療審閱者時，reviewedBy 升級為
  // Person（含 hasCredential），這才是 E-E-A-T 有分量的部分。沒掛才退回機構級。
  author: PUBLISHER_REF,
  reviewedBy: data.reviewer ? buildPerson(data.reviewer) : PUBLISHER_REF,
  ...(data.reviewer ? { lastReviewed: data.updatedDate.toISOString() } : {}),
  publisher: PUBLISHER_REF,
  isPartOf: WEBSITE_REF,
  about: {
    '@type': 'Thing',
    name: data.title,
  },
  ...(ingredientCitations ? { citation: ingredientCitations } : {}),
  articleSection: '成分解析',
  mainEntityOfPage: `https://evidencetoday.news/ingredients/${slug}/`,
};

const ingredientBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://evidencetoday.news/' },
    { '@type': 'ListItem', position: 2, name: '成分解析', item: 'https://evidencetoday.news/ingredients/' },
    { '@type': 'ListItem', position: 3, name: data.title, item: `https://evidencetoday.news/ingredients/${slug}/` },
  ],
};
---

<Article
  title={data.title}
  description={social.description}
  seoTitle={data.seoTitle ?? social.title}
  socialTitle={social.title}
  socialDescription={social.description}
  ogImage={social.image}
  coverImage={data.coverImage}
  coverAlt={data.coverAlt}
  coverImageCredit={data.coverImageCredit}
  category="ingredient"
  publishDate={data.publishDate}
  updatedDate={data.updatedDate}
  reviewer={data.reviewer}
  tags={data.tags}
  breadcrumbItems={[
    { label: '首頁', href: '/' },
    { label: '成分解析', href: '/ingredients/' },
    { label: data.title },
  ]}
  references={data.references}
  citationAnswer={data.introduction}
>
  <Fragment slot="head">
    <JsonLd data={ingredientArticleSchema} />
    <JsonLd data={ingredientBreadcrumbSchema} />
  </Fragment>

  <Content />

  {/*
    安全性與交互作用（2026-08-06 接線）。
    `ingredientsSchema.safety` 從建站起就有資料——20 篇成分頁寫了一般安全性、
    交互作用與族群注意——但沒有任何模板讀它，讀者一個字都看不到。
    `docs/page-rules/ingredients.md` 早就規定「content 有 safety 欄位時，模板需
    固定輸出『安全性與交互作用』區塊」，屬於規格寫了、實作沒做。勿再移除。

    刻意只接 safety，不接 uses：寫得好的成分頁（如 taurine、urolithin-a）body
    已用散文講過用途與證據，把 uses 也渲染出來會在同一頁產生兩份近似內容。
    safety 是條列式的交互作用與族群注意，body 通常不會逐條重複，重疊風險低。
  */}
  {data.safety && (
    <section class="ingredient-safety" aria-labelledby="ingredient-safety-title">
      <h2 id="ingredient-safety-title">安全性與交互作用</h2>
      <p>{data.safety.general}</p>

      {data.safety.interactions && data.safety.interactions.length > 0 && (
        <>
          <h3>可能的交互作用</h3>
          <dl>
            {data.safety.interactions.map((item) => (
              <>
                <dt>{item.substance}</dt>
                <dd>{item.description}</dd>
              </>
            ))}
          </dl>
        </>
      )}

      {data.safety.populations && data.safety.populations.length > 0 && (
        <>
          <h3>特定族群注意事項</h3>
          <dl>
            {data.safety.populations.map((item) => (
              <>
                <dt>{item.group}</dt>
                <dd>{item.note}</dd>
              </>
            ))}
          </dl>
        </>
      )}
    </section>
  )}

  <Fragment slot="sidebar">
    {headings.length > 0 && (
      <TableOfContents headings={headings} client:idle />
    )}
  </Fragment>

  {(hasRelated || belongingTopics.length > 0) && (
    <Fragment slot="after-content">
      {belongingTopics.length > 0 && (
        <nav class="topic-hubs" aria-label="所屬健康專題">
          <h2 class="topic-hubs__title">所屬健康專題</h2>
          <div class="topic-hubs__links">
            {belongingTopics.map((t) => (
              <a class="topic-hubs__link" href={`/topics/${t.slug}/`}>{t.name}</a>
            ))}
          </div>
        </nav>
      )}
      {hasRelated && (
      <section class="related-content">
        <h2 class="related-content__title">相關內容</h2>
        <div class="related-content__grid">
          {relatedArticles.map((a) => (
            <ArticleCard
              title={a.data.title}
              description={a.data.description}
              href={`/articles/${stripExt(a.id)}/`}
              category="article"
              coverImage={a.data.coverImage}
              coverAlt={a.data.coverAlt}
              author={a.data.author}
              date={fmtDate(a.data.publishDate)}
              editorReviewed={a.data.editorReviewed}
            />
          ))}
          {relatedMyths.map((m) => (
            <MythCard
              title={m.data.title}
              verdictSummary={m.data.verdictSummary}
              href={`/myths/${stripExt(m.id)}/`}
              verdict={m.data.verdict}
              date={fmtDate(m.data.publishDate)}
            />
          ))}
          {relatedVideos.map((v) => (
            <VideoCard
              title={v.data.title}
              tldr={v.data.tldr}
              href={`/videos/${stripExt(v.id)}/`}
              youtubeId={v.data.youtubeId}
            />
          ))}
          {relatedPodcasts.map((p) => (
            <PodcastCard
              title={p.data.title}
              description={p.data.description}
              href={`/podcasts/${stripPodcastSlug(p.id)}/`}
              episodeNumber={p.data.episodeNumber}
              duration={p.data.duration}
              publishDate={p.data.publishDate}
            />
          ))}
        </div>
      </section>
      )}
    </Fragment>
  )}
</Article>
<EditButton client:idle repoPath={`src/content/ingredients/${entry.id}`} collection="ingredients" slug={slug} />
<ReadingEngagement client:idle contentType="ingredient" slug={slug} tags={data.tags} hasRelated={hasRelated} />

<style>
  /* 安全性與交互作用：接在內文之後的固定區塊。
     用 dl 而非 ul，因為每一條都是「對象 → 說明」的配對，語意上是定義列表；
     螢幕閱讀器可據此把物質名與說明關聯起來。字級全部走 --text-* 階梯。 */
  .ingredient-safety {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-fog);
  }

  .ingredient-safety h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h2);
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 1rem;
  }

  .ingredient-safety h3 {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-ink);
    margin: 1.5rem 0 0.75rem;
  }

  .ingredient-safety p {
    font-size: var(--text-body);
    line-height: 1.8;
    color: var(--color-ink);
    margin: 0;
  }

  .ingredient-safety dl {
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }

  .ingredient-safety dt {
    font-size: var(--text-body);
    font-weight: 700;
    color: var(--color-ink);
  }

  .ingredient-safety dd {
    margin: 0.25rem 0 0;
    font-size: var(--text-body);
    line-height: 1.75;
    color: var(--color-ink);
  }

  /* spoke→hub 專題膠囊，與 articles/[slug].astro 同一套視覺 */
  .topic-hubs {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .topic-hubs__title {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-ink);
  }

  .topic-hubs__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .topic-hubs__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-ui);
    font-size: var(--text-meta);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-teal);
    background: var(--color-teal-subtle);
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
  }

  .topic-hubs__link::before {
    content: '專題';
    font-size: 0.7em;
    font-weight: 700;
    opacity: 0.7;
  }

  .related-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .related-content__title {
    font-family: var(--font-sans);
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-ink);
  }

  .related-content__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-card-gap);
  }

  @media (min-width: 640px) {
    .related-content__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

</style>
