---
import { getCollection } from 'astro:content';
import Article from '@/layouts/Article.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import { buildClaimReview, buildPerson, buildCitations, PUBLISHER_REF, WEBSITE_REF } from '@/utils/schema-org';
import { isPublicEntry } from '@/utils/visibility';
import VerdictBadge from '@/components/ui/VerdictBadge.astro';
import { validateMythArticle } from '@/utils/myths/validate';
import { displayVerdict } from '@/utils/myths/schema';
import { contentSocial } from '@/utils/social-meta.mjs';
import EditButton from '@/components/editor/EditButton.svelte';
import ReadingEngagement from '@/components/blocks/ReadingEngagement.svelte';

export async function getStaticPaths() {
  const entries = await getCollection('myths', ({ data }) => isPublicEntry(data));
  return entries.map((entry) => ({ params: { slug: entry.id.replace(/\.[^.]+$/, '') }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const social = contentSocial('myths', d, entry.id.replace(/\.[^.]+$/, ''));
const errors = validateMythArticle(entry);
if (errors.length > 0) throw new Error(`[myth:${entry.id}] ${errors.join(' | ')}`);

const canonical = `https://evidencetoday.news/myths/${entry.id.replace(/\.[^.]+$/, '')}/`;
const refs = (d.references || []).filter((r) => r?.title && r?.url);
const quickItems = d.thirtySecondConclusion?.length ? d.thirtySecondConclusion : d.tldr;
const whyItems = Array.isArray(d.whyItSpreads)
  ? d.whyItSpreads
  : [d.whyItSpreads.commonClaim, d.whyItSpreads.shortVideoVersion, d.whyItSpreads.adVersion, d.whyItSpreads.familyChatVersion].filter(Boolean);
const evidenceItems = d.evidenceSummary?.evidenceItems || [];
const shareSummary = d.cardConclusion || d.verdictSummary;
const mythCitations = buildCitations(d.references);
// 與 articles 同一套規則：審閱者 ≠ 作者才輸出 Person 級 reviewedBy（獨立審閱才有 E-E-A-T
// 價值），否則退為機構層級。2026-08-06 前 myths frontmatter 已寫 reviewer 但前台從未接，
// 署名與 reviewedBy 都沒輸出；此處補上，勿再移除。
const mythIndependentReviewer = d.reviewer && d.reviewer !== d.author;
const mythReviewedBy = mythIndependentReviewer
  ? buildPerson(d.reviewer)
  : d.reviewer
    ? { '@type': 'Organization', name: '本日有據', url: 'https://evidencetoday.news/' }
    : null;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonical}#article`,
  headline: social.title,
  description: social.description,
  inLanguage: 'zh-Hant-TW',
  image: [social.image],
  datePublished: d.publishDate.toISOString(),
  dateModified: d.updatedDate.toISOString(),
  author: buildPerson(d.author),
  ...(mythReviewedBy ? { reviewedBy: mythReviewedBy, lastReviewed: d.updatedDate.toISOString() } : {}),
  publisher: PUBLISHER_REF,
  isPartOf: WEBSITE_REF,
  ...(mythCitations ? { citation: mythCitations } : {}),
  mainEntityOfPage: canonical,
} satisfies Record<string, unknown>;
const claimReview = buildClaimReview({
  mythClaim: d.mythClaim,
  verdict: d.verdict,
  verdictSummary: d.verdictSummary,
  publishDate: d.publishDate,
  updatedDate: d.updatedDate,
  url: canonical,
  name: social.title,
});
const splitCarefulItem = (item: string) => {
  const match = item.match(/^\*\*(.+?)：\*\*\s*(.+)$/);
  return match ? { label: match[1], text: match[2] } : { label: '', text: item };
};
const sourceTypeLabels: Record<string, string> = {
  'official-agency': '官方機構健康教育資料',
  guideline: '指引或專業組織資料',
  'expert-review': '醫學機構資料',
  'systematic-review': '系統性回顧',
  'meta-analysis': '統合分析',
  rct: '隨機對照試驗',
  cohort: '世代研究',
  observational: '觀察性研究',
  'cochrane-review': 'Cochrane 系統性回顧',
  'safety-database': '安全性資料庫',
  animal: '動物研究',
  'in-vitro': '細胞或體外研究',
  'case-report': '個案報告',
};
// 優先用該篇 frontmatter 的 medicalDisclaimer——那是逐篇寫的，含該主題的具體警訊症狀
// 與建議科別（例如血便、排便習慣改變 → 消化內科），比通用句對讀者有用得多。
// 2026-08-06 前這裡寫死通用字串，74 篇客製文案全被繞過、讀者一個字都看不到；
// mythsSchema.medicalDisclaimer 是 required，等於每篇都認真寫了然後丟掉。勿再改回寫死。
const FALLBACK_REMINDER = '本文為健康資訊與迷思查證，不提供個人診斷或治療建議。若你已被診斷疾病、正在服藥、懷孕、哺乳，或症狀持續未改善，請諮詢醫師、藥師或營養師。';
const healthReminder = d.medicalDisclaimer?.trim() || FALLBACK_REMINDER;

/* ── 「怎麼做才安全」區塊（2026-08-06 新增）────────────────────────────────
 * safeActions / avoidActions / whenToSeekProfessionalAdvice 三欄從建站起就寫在
 * 每篇 frontmatter（前兩者是 required），但從未被任何模板讀取——74 篇逐篇寫的
 * 「該做什麼／別做什麼／何時該就醫」讀者一個字都看不到。這是本站最實用、也最
 * 該被 AI 答案引擎引用的內容。
 *
 * ⚠️ 這一次是**刻意推翻**「myths 版型只渲染固定區塊」的舊決策，經使用者
 * 2026-08-06 明確授權。舊規則的用意是擋掉「延伸閱讀／相關內容／更新紀錄」這類
 * 為 SEO 硬加的導覽區塊；這裡加的是該篇自己的安全內容，性質不同。
 * 相關文件（topic-hubs.md、pitfalls.md、page-rules/myths.md）已同步改寫。
 *
 * whenToSeekProfessionalAdvice 只在「不等於通用句」時輸出：74 篇裡有 28 篇填的
 * 是與頁尾免責幾乎同義的通用句，兩處都印就變成同一頁講兩次，違反硬規則 8a
 * 「免責一頁一次、絕不重複」。那 28 篇的訊息由頁尾 health-reminder 承擔即可。
 */
const GENERIC_SEEK_ADVICE = '若症狀持續、惡化、影響生活，或你正考慮停藥、換藥、高劑量補充，請先諮詢醫師、藥師或營養師。';
const seekAdvice = d.whenToSeekProfessionalAdvice?.trim();
const specificSeekAdvice = seekAdvice && seekAdvice !== GENERIC_SEEK_ADVICE ? seekAdvice : null;
const hasSafetyBlock = d.safeActions?.length > 0 || d.avoidActions?.length > 0 || specificSeekAdvice;

const slugId = entry.id.replace(/\.[^.]+$/, '');
const squareCardImage = `/og/myths/${slugId}-square.png`;
const lineShareUrl = `https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(canonical)}`;

// 麵包屑：其他內容型皆有 BreadcrumbList，闢謠頁原本缺，補上並帶「迷思查證」中間層。
const mythBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://evidencetoday.news/' },
    { '@type': 'ListItem', position: 2, name: '迷思查證', item: 'https://evidencetoday.news/myths/' },
    { '@type': 'ListItem', position: 3, name: d.title, item: canonical },
  ],
};

// FAQPage：闢謠頁已渲染可見 Q&A（下方 d.faq 區塊），比照文章頁輸出 FAQPage，取得 rich result 資格。
const mythFaqSchema = d.faq && d.faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: d.faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : null;
---

<Article title={d.title} description={social.description} seoTitle={d.seoTitle ?? social.title} socialTitle={social.title} socialDescription={social.description} ogImage={social.image} category="myth" variant="cards" showMedicalDisclaimer={false} publishDate={d.publishDate} updatedDate={d.updatedDate} author={d.author} reviewer={d.reviewer} tags={d.topicTags} breadcrumbItems={[{ label: '首頁', href: '/' }, { label: '迷思查證', href: '/myths/' }, { label: d.title }]}>
  <Fragment slot="head">
    <meta property="article:published_time" content={d.publishDate.toISOString()} />
    <meta property="article:modified_time" content={d.updatedDate.toISOString()} />
    <meta property="article:author" content={d.author} />
    <JsonLd data={[articleLd, claimReview, mythBreadcrumbSchema, ...(mythFaqSchema ? [mythFaqSchema] : [])]} />
  </Fragment>

  <section class="block quick">
    <div class="quick-panel">
      <h2>30 秒快速結論</h2>
      <div class="quick-badges">
        <VerdictBadge verdict={d.verdict} size="lg" />
        <span class="pill evidence">證據強度：{d.evidenceLevel}</span>
      </div>
    </div>
    <div>
      <ul>{quickItems.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="block flow">
    <h2>坊間怎麼流傳，為什麼容易相信？</h2>
    <p>{d.currentSituation}</p>
    {d.popularVersions?.length > 0 && <ul>{d.popularVersions.map((item) => <li>{item}</li>)}</ul>}
    {whyItems.map((item) => <p>{item}</p>)}
  </section>

  <section class="block science">
    <h2>科學證據怎麼看？</h2>
    {evidenceItems.length > 0 && (
      <div class="evidence-list">
        {evidenceItems.map((item, index) => (
          <article class="evidence-item">
            {index > 0 && <hr />}
            <h3>來源 {index + 1}：{item.title}</h3>
            <p><strong>研究類型：</strong>{sourceTypeLabels[item.sourceType] || item.sourceType}</p>
            <p><strong>主要發現：</strong>{item.mainFinding}</p>
          </article>
        ))}
      </div>
    )}
  </section>

  <section class="block reasoning">
    <h2>白話辯證</h2>
    {d.reasoningCards?.length ? (
      <div class="myth-reasoning-grid">
        {d.reasoningCards.map((card) => (
          <div class={`myth-reasoning-card myth-reasoning-card--${card.tone}`}>
            <h3>{card.title}</h3>
            <ul>{card.items.map((item) => <li>{item}</li>)}</ul>
          </div>
        ))}
      </div>
    ) : (
      <p>{d.plainLanguageReasoning || d.plainLanguageAnalysis}</p>
    )}
  </section>

  {d.whoShouldBeCareful?.length > 0 && <section class="block"><h2>哪些人要特別小心？</h2><ul>{d.whoShouldBeCareful.map((item) => { const carefulItem = splitCarefulItem(item); return <li>{carefulItem.label ? <><strong>{carefulItem.label}：</strong>{carefulItem.text}</> : carefulItem.text}</li>; })}</ul></section>}
  {hasSafetyBlock && (
    <section class="block">
      <h2>那，實際上該怎麼做？</h2>
      <div class="myth-reasoning-grid">
        {d.safeActions?.length > 0 && (
          <div class="myth-reasoning-card myth-reasoning-card--blue">
            <h3>可以這樣做</h3>
            <ul>{d.safeActions.map((item) => <li>{item}</li>)}</ul>
          </div>
        )}
        {d.avoidActions?.length > 0 && (
          <div class="myth-reasoning-card myth-reasoning-card--red">
            <h3>不建議這樣做</h3>
            <ul>{d.avoidActions.map((item) => <li>{item}</li>)}</ul>
          </div>
        )}
      </div>
      {specificSeekAdvice && (
        <p class="seek-advice"><strong>什麼時候該找專業人員：</strong>{specificSeekAdvice}</p>
      )}
    </section>
  )}
  {d.faq?.length > 0 && <section class="block"><h2>FAQ</h2>{d.faq.map((item) => <article><h3>{item.question}</h3><p>{item.answer}</p></article>)}</section>}

  <section class="block share-block">
    <h2>分享這篇文章</h2>
    <p>覺得這篇有幫助？歡迎分享給身邊也常遇到這類健康說法的人。分享出去會顯示這張卡片：</p>
    <div class="share-preview">
      <img src={social.image} width="600" height="315" loading="lazy" decoding="async" alt={`分享卡片預覽：${d.title}，判讀${displayVerdict(d.verdict)}`} />
    </div>
    <div class="share">
      <a id="line-share-btn" class="share-line" href={lineShareUrl} target="_blank" rel="noopener noreferrer" aria-label="分享到 LINE">分享到 LINE</a>
      <button id="share-btn" aria-label="分享這篇文章">分享這篇文章</button>
      <button id="copy-btn" aria-label="複製連結">複製連結</button>
      <a class="download-card" href={squareCardImage} download={`${slugId}-闢謠圖卡.png`} aria-label="下載可直接傳的圖卡">下載圖卡</a>
    </div>
    <p id="share-status" aria-live="polite"></p>
  </section>
  {refs.length > 0 && <section class="block"><h2>References</h2><ol>{refs.map((r) => <li><strong>{r.title}</strong>{r.sourceType ? `（類型：${r.sourceType}）` : ''}{r.evidenceType ? `（證據類型：${r.evidenceType}）` : ''}<br /><a href={r.url} target="_blank" rel="noopener noreferrer">{r.url}</a></li>)}</ol></section>}
  <aside class="health-reminder" aria-label="健康資訊提醒"><p>{healthReminder}</p></aside>
  <EditButton client:idle repoPath={`src/content/myths/${entry.id}`} collection="myths" slug={entry.id.replace(/\.[^.]+$/, '')} />
  <ReadingEngagement client:idle contentType="myth" slug={entry.id.replace(/\.[^.]+$/, '')} tags={d.topicTags} author={d.author} verdict={d.verdict} evidenceLevel={d.evidenceLevel} hasRelated={false} />
</Article>
<script define:vars={{ canonical, title: d.title, summary: shareSummary }}>
const status = document.getElementById('share-status');
document.getElementById('share-btn')?.addEventListener('click', async () => { if (navigator.share) { await navigator.share({ title, text: summary, url: canonical }); status.textContent = '已開啟分享'; return; } await navigator.clipboard.writeText(canonical); status.textContent = '已複製連結'; });
document.getElementById('copy-btn')?.addEventListener('click', async () => { await navigator.clipboard.writeText(canonical); status.textContent = '已複製連結'; });
</script>
<style>
  /* ---- Base (mobile) ---- */
  .block {
    background: color-mix(in oklch, var(--color-paper) 55%, white);
    border: 1px solid var(--color-fog);
    border-radius: 14px;
    padding: clamp(1rem, 0.5rem + 2vw, 2.125rem);
    margin-top: 1rem;
    color: var(--color-ink);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .block :is(h1, h2, h3) {
    margin: 0 0 12px;
  }

  /* 「什麼時候該找專業人員」：接在該做／別做兩張卡之後的單行提示。
     它是可行動的就醫時機，不是免責聲明，所以維持內文字級與正常彩度；
     真正的免責由頁尾 .health-reminder 承擔（見下一條）。 */
  .seek-advice {
    margin: 1rem 0 0;
    font-size: var(--text-body);
    line-height: 1.75;
    color: var(--color-ink);
  }

  /* 硬規則 8a：免責一頁一次、放角落、降彩度、字級不得低於 --text-meta。
     低干擾靠「降彩度＋去卡片化」達成，不靠縮字——所以這裡拿掉 .block 的白底卡片
     與 h2 標題，只留一條左側細線與 muted 文字色，字級維持 --text-meta（1.125rem）。 */
  .health-reminder {
    margin-top: 1.5rem;
    padding: 0.75rem 0 0.75rem 1rem;
    border-left: 2px solid var(--color-fog);
    color: var(--color-ink-subtle);
    font-size: var(--text-meta);
  }

  .health-reminder p {
    margin: 0;
  }

  /* Quick conclusion — single column on mobile */
  .quick {
    background: color-mix(in oklch, var(--color-teal) 8%, white);
    border: 1px solid color-mix(in oklch, var(--color-teal) 24%, var(--color-fog));
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .quick-panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .quick-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .pill {
    display: inline-flex;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: clamp(0.875rem, 0.8rem + 0.5vw, 1.125rem);
    font-weight: 700;
  }

  .evidence {
    background: color-mix(in oklch, var(--color-teal) 10%, white);
    color: var(--color-teal);
    border: 1px solid color-mix(in oklch, var(--color-teal) 28%, var(--color-fog));
  }

  .flow {
    background: color-mix(in oklch, var(--color-paper) 78%, white);
  }

  .evidence-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .evidence-item hr {
    border: 0;
    border-top: 1px solid color-mix(in oklch, var(--color-fog) 82%, var(--color-ink));
    margin: 0 0 1.25rem;
  }

  .myth-reasoning-grid {
    display: grid;
    gap: 1rem;
  }

  .myth-reasoning-card {
    border-radius: 14px;
    padding: clamp(1rem, 0.75rem + 1vw, 1.5rem);
  }

  .myth-reasoning-card--blue {
    background: color-mix(in oklch, var(--color-teal) 10%, white);
    border: 1px solid color-mix(in oklch, var(--color-teal) 28%, var(--color-fog));
  }

  .myth-reasoning-card--red {
    background: color-mix(in oklch, var(--color-coral) 9%, white);
    border: 1px solid color-mix(in oklch, var(--color-coral) 30%, var(--color-fog));
  }

  .share-preview {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--color-fog);
    box-shadow: var(--shadow-card);
    max-width: 480px;
    margin: 0 auto;
  }

  .share-preview img {
    display: block;
    width: 100%;
    height: auto;
  }

  .share-block,
  .share,
  .share :is(button, a) {
    font-size: 1rem;
  }

  .share {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-top: 1rem;
  }

  .share :is(button, a) {
    min-height: 44px;
    padding: 0.75rem 1rem;
  }

  button,
  .share a {
    padding: 0.65rem 0.95rem;
    border-radius: 10px;
    border: 1px solid var(--color-fog);
    color: var(--color-ink);
    background: color-mix(in oklch, var(--color-paper) 55%, white);
    text-align: center;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #line-share-btn {
    border-color: var(--color-line-brand);
    background: var(--color-line-brand);
    color: white;
    font-weight: 700;
  }

  #share-btn {
    border-color: var(--color-teal);
    background: var(--color-teal);
    color: white;
  }

  #copy-btn,
  .download-card {
    border-color: var(--color-fog);
    background: color-mix(in oklch, var(--color-paper) 55%, white);
    color: var(--color-ink);
  }

  /* ---- Tablet and up (768px) ---- */
  @media (min-width: 768px) {
    .quick {
      display: grid;
      grid-template-columns: 1fr 1.25fr;
    }

    .myth-reasoning-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .share {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .share :is(button, a) {
      flex: 1 1 160px;
    }
  }
</style>
