---
import Base from '@/layouts/Base.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import CategoryTag from '@/components/ui/CategoryTag.astro';
import AuthorMeta from '@/components/blocks/AuthorMeta.astro';
import EditorInfo from '@/components/blocks/EditorInfo.astro';
import TldrBox from '@/components/blocks/TldrBox.astro';
import FaqAccordion from '@/components/blocks/FaqAccordion.astro';
import ReferenceList from '@/components/blocks/ReferenceList.astro';
import MedicalDisclaimer from '@/components/blocks/MedicalDisclaimer.astro';
import ShareButtons from '@/components/blocks/ShareButtons.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  title: string;
  description: string;
  seoTitle?: string;
  socialTitle?: string;
  socialDescription?: string;
  ogImage?: string;
  coverImage?: string;
  coverAlt?: string;
  coverImageCredit?: string;
  category: 'article' | 'myth' | 'ingredient';
  variant?: 'prose' | 'cards';
  publishDate: Date;
  updatedDate: Date;
  author?: string;
  reviewer?: string;
  readingTime?: number;
  editorReviewed?: boolean;
  disclosure?: boolean;
  tags: string[];
  breadcrumbItems: Array<{ label: string; href?: string }>;
  faq?: Array<{ question: string; answer: string }>;
  references?: Array<{ title: string; url?: string; type: string }>;
  citationAnswer?: string;
  /** 可截取的直球答案，渲染成「重點摘要」的首句（不取代 tldr）。 */
  aiAnswer?: string;
  queryPatternLabel?: string;
  showMedicalDisclaimer?: boolean;
}

const {
  title,
  description,
  seoTitle,
  socialTitle,
  socialDescription,
  ogImage,
  coverImage,
  coverAlt,
  coverImageCredit,
  category,
  variant = 'prose',
  publishDate,
  updatedDate,
  author,
  reviewer,
  readingTime,
  editorReviewed = false,
  disclosure,
  tags,
  breadcrumbItems,
  faq,
  references,
  citationAnswer,
  aiAnswer,
  queryPatternLabel,
  // 預設關閉（2026-08-04 改）：通用醫療免責由頁尾單一處承擔，內文不再放同義句。
  // 原本內文區塊寫「本站所有內容僅供一般健康資訊參考，不構成醫療診斷、治療建議或處方」，
  // 與 Footer 的「本站內容僅供一般健康資訊參考，不構成醫療建議」前 15 字幾乎逐字重複，
  // 出現在每一篇文章與成分頁。規則見 docs/playbooks/legal-notices.md。
  // 個別頁面若真有非通用的提醒需求，才顯式傳 true。
  showMedicalDisclaimer = false,
} = Astro.props;

// 分享列：用 canonical 絕對網址。myths 單篇刻意極簡（見 CLAUDE.md 與 myths playbook），不加分享列。
const shareUrl = new URL(Astro.url.pathname, Astro.site).href;
const showShare = category !== 'myth';
const hasSidebar = Astro.slots.has('sidebar');

// 封面圖安全守衛：外連 http(s) 直接採用；本地 `/…` 路徑須確認 public 下真的存在，
// 避免填錯路徑在詳情頁露破圖（與 ArticleCard 同一套判斷）。用 process.cwd() 而非
// import.meta.url 相對路徑：production build 打包後元件的 import.meta.url 會指向 bundle
// chunk 位置而非原始 src 路徑，相對推算的 `../` 層數會失準；astro build 執行時 cwd 恆為
// 專案根目錄，兩種環境都可靠。
const safeCover =
  typeof coverImage === 'string' &&
  (coverImage.startsWith('http://') ||
    coverImage.startsWith('https://') ||
    (coverImage.startsWith('/') && existsSync(join(process.cwd(), 'public', coverImage))))
    ? coverImage
    : undefined;
---

<Base title={seoTitle ?? `${title}｜本日有據`} description={description} ogTitle={socialTitle} ogDescription={socialDescription ?? description} ogImage={ogImage} ogType="article">
  <Fragment slot="head"><slot name="head" /></Fragment>
  <div class="article-layout container">
    <Breadcrumb items={breadcrumbItems} />

    <header class="article-header">
      {/* 2026-11-28：類別與題型改成同一行純文字；「主編把關」只留在下方署名列（原本頂部也有一顆，重複）；
          日期列移到標題下方，讓標題在手機第一屏上移。 */}
      <div class="article-header__meta">
        <CategoryTag category={category} />
        {queryPatternLabel && <span class="article-header__aeo">{queryPatternLabel}</span>}
      </div>
      <h1>{title}</h1>
      {(author || reviewer || disclosure) && (
        <EditorInfo
          author={author ?? '編輯部'}
          reviewer={reviewer}
          editorReviewed={editorReviewed}
          disclosure={disclosure}
        />
      )}
      <AuthorMeta publishDate={publishDate} updatedDate={updatedDate} readingTime={readingTime} />
    </header>

    {safeCover && (
      <figure class="article-cover">
        <img src={safeCover} alt={coverAlt || title} loading="eager" />
        {coverImageCredit && <figcaption class="article-cover__credit">圖片／{coverImageCredit}</figcaption>}
      </figure>
    )}

    <div class:list={['article-grid', `article-grid--${variant}`]}>
      {/* 2026-11-28：目錄改放在正文前的 DOM 位置。手機收成一條可展開的「本文目錄」（原本手機完全看不到目錄），
          桌機仍是右欄 sticky（用 grid-column 放回右邊，腳本把 details 設成展開）。 */}
      {hasSidebar && (
        <aside class="article-sidebar">
          <details class="article-toc" data-article-toc>
            <summary class="article-toc__summary">本文目錄</summary>
            <slot name="sidebar" />
          </details>
        </aside>
      )}
      <div class="article-content">
        {citationAnswer && <TldrBox summary={citationAnswer} lead={aiAnswer} />}
        <div class="prose">
          <slot />
        </div>
        {faq && faq.length > 0 && (
          <section class="article-faq">
            <h2>常見問題</h2>
            <FaqAccordion items={faq} />
          </section>
        )}
        {references && references.length > 0 && (
          <section class="article-references">
            <ReferenceList references={references} />
          </section>
        )}
        {tags && tags.length > 0 && (
          <nav class="article-tags" aria-label="相關主題標籤">
            <span class="article-tags__label">相關主題</span>
            <div class="article-tags__list">
              {tags.map((tag) => (
                <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
              ))}
            </div>
          </nav>
        )}
        {showMedicalDisclaimer && <MedicalDisclaimer />}
        {showShare && <ShareButtons url={shareUrl} title={title} />}
        <slot name="after-content" />
      </div>
    </div>
  </div>
</Base>

<script>
  // 桌機（≥1024）目錄常駐展開；手機維持收合。跨斷點時同步。
  const mq = window.matchMedia('(min-width: 1024px)');
  const sync = () => {
    document.querySelectorAll<HTMLDetailsElement>('[data-article-toc]').forEach((d) => {
      d.open = mq.matches;
    });
  };
  sync();
  mq.addEventListener('change', sync);
</script>

<style>
  .article-layout {
    padding-block: var(--space-page-y);
  }

  .article-header {
    padding-block: 1.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .article-header__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .article-header__aeo {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-ui);
    font-size: var(--text-meta);
    color: var(--color-ink-muted);
  }

  .article-header__aeo::before {
    content: '·';
    margin-inline-end: 0.5rem;
    color: var(--color-ink-subtle);
  }

  .article-header h1 {
    max-width: 40ch;
  }

  /* 詳情頁主視覺封面：固定 16/9、桌機以 max-height 收斂避免過高，object-fit 裁切保比例 */
  .article-cover {
    margin-block: 0 clamp(1rem, 0.5rem + 1.5vw, 1.75rem);
  }

  .article-cover img {
    width: 100%;
    max-height: 24rem;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    border-radius: var(--radius-card);
  }

  .article-cover__credit {
    margin-top: 0.5rem;
    font-size: var(--text-meta);
    color: var(--color-ink-muted);
  }

  .article-grid {
    display: grid;
    min-width: 0;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-block: 2rem;
  }

  /* 2026-11-28：拿掉正文外層白卡（裡面還有摘要框，形成卡中卡，也讓手機正文欄被兩層內距吃掉），
     正文直接放在紙色底上。 */
  .article-grid--prose {
    padding-block: 1rem 2rem;
  }

  .article-grid--cards {
    background: transparent;
    padding: 0;
  }

  .article-grid--cards .article-content {
    max-width: none;
  }

  .article-grid--cards .prose {
    max-width: none;
  }

  .article-content {
    max-width: 68ch;
    min-width: 0;
    overflow-wrap: anywhere;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .article-faq {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .article-references {
    margin-top: 0;
  }

  .article-tags {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .article-tags__label {
    font-size: var(--text-meta);
    color: var(--color-ink-muted);
  }

  .article-tags__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .article-tags__list a {
    background: var(--color-teal-subtle);
    color: var(--color-navy);
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: var(--text-meta);
  }

  .article-sidebar {
    min-width: 0;
  }

  .article-toc {
    border: 1px solid var(--color-fog);
    border-radius: var(--radius-sm);
    background-color: var(--color-white);
    padding: 0.75rem 1rem;
  }

  .article-toc__summary {
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: var(--text-meta);
    font-weight: 700;
    color: var(--color-ink);
  }

  .article-toc[open] .article-toc__summary {
    margin-bottom: 0.5rem;
  }

  /* 手機的 summary 已寫「本文目錄」，元件自己的「目錄」小標重複，手機隱藏 */
  .article-toc :global(.toc__title) {
    display: none;
  }

  /* 桌機：正文欄固定在易讀寬度，目錄緊跟在旁（原本 0.7fr／0.3fr 讓兩欄之間空出一大塊） */
  @media (min-width: 1024px) {
    .article-grid--prose {
      grid-template-columns: minmax(0, 68ch) minmax(14rem, 17rem);
      column-gap: clamp(2.5rem, 1rem + 3vw, 4.5rem);
    }

    .article-content {
      grid-column: 1;
      grid-row: 1;
    }

    .article-sidebar {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: 6rem;
      align-self: start;
    }

    .article-toc {
      border: 0;
      background: transparent;
      padding: 0;
    }

    .article-toc__summary {
      display: none;
    }

    .article-toc :global(.toc__title) {
      display: inline;
    }
  }
</style>
